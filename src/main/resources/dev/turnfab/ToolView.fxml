<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.turnfab.ToolViewController">
   <children>
      <SplitPane dividerPositions="0.5" orientation="VERTICAL" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
         <items>
            <TableView fx:id="tbvTools" prefHeight="200.0">
               <columns>
                  <TableColumn fx:id="tbcToolName" editable="false" prefWidth="250.0" resizable="false" text="Tool" />
                  <TableColumn fx:id="tbcToolNumParams" editable="false" prefWidth="60.0" resizable="false" text="Params" />
                  <TableColumn fx:id="tbcToolDesc" editable="false" prefWidth="500.0" text="Description" />
               </columns>
            </TableView>
            <TabPane tabClosingPolicy="UNAVAILABLE">
              <tabs>
                <Tab closable="false" text="Description">
                     <content>
                        <TextArea fx:id="txaDesc" editable="false" wrapText="true" />
                     </content>
                  </Tab>
                <Tab closable="false" text="Parameters">
                     <content>
                        <TextArea fx:id="txaParams" editable="false" wrapText="true" />
                     </content>
                  </Tab>
              </tabs>
            </TabPane>
         </items>
      </SplitPane>
   </children>
</AnchorPane>
