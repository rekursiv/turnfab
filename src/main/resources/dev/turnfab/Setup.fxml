<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>
<?import javafx.scene.text.*?>
<?import org.controlsfx.control.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.turnfab.SetupController">
   <children>
      <HBox>
         <children>
            <Label text="Setup:">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
            </Label>
            <ChoiceBox fx:id="chbSetup" prefWidth="180.0">
               <HBox.margin>
                  <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
               </HBox.margin>
            </ChoiceBox>
            <Button mnemonicParsing="false" onAction="#onSaveSetup" text="Save Setup">
               <HBox.margin>
                  <Insets bottom="4.0" left="20.0" right="4.0" top="4.0" />
               </HBox.margin>
            </Button>
            <CheckBox fx:id="ckbSaveAs" mnemonicParsing="false" onAction="#onSaveAs" text="As:">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
            </CheckBox>
            <TextField fx:id="txfSaveAs" disable="true">
               <HBox.margin>
                  <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
               </HBox.margin>
            </TextField>
            <Label text=".yaml">
               <HBox.margin>
                  <Insets bottom="4.0" left="2.0" right="8.0" top="12.0" />
               </HBox.margin>
            </Label>
            <CheckBox fx:id="ckbThink" mnemonicParsing="false" onAction="#onCkbThink" text="Enable Thinking">
               <HBox.margin>
                  <Insets bottom="8.0" left="20.0" right="8.0" top="8.0" />
               </HBox.margin>
            </CheckBox>
            <CheckBox fx:id="ckbLogReq" mnemonicParsing="false" text="Log Requests">
               <HBox.margin>
                  <Insets bottom="8.0" left="40.0" right="8.0" top="8.0" />
               </HBox.margin>
            </CheckBox>
            <CheckBox fx:id="ckbLogRes" mnemonicParsing="false" text="Log Responses">
               <HBox.margin>
                  <Insets bottom="8.0" left="8.0" right="8.0" top="8.0" />
               </HBox.margin>
            </CheckBox>
         </children>
         <VBox.margin>
            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
         </VBox.margin>
      </HBox>
      <TitledPane animated="false" collapsible="false" contentDisplay="RIGHT" graphicTextGap="40.0" text="System Prompt">
         <content>
            <TextArea fx:id="txaSysPrompt" prefRowCount="5" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </TextArea>
         </content>
         <graphic>
            <CheckBox fx:id="ckbAddDate" mnemonicParsing="false" text="Add Date" />
         </graphic>
      </TitledPane>
      <HBox prefHeight="200.0">
         <children>
            <TitledPane animated="false" collapsible="false" prefWidth="130.0" text="MCP Servers" HBox.hgrow="NEVER">
               <content>
                  <CheckListView fx:id="clvMcpServers" />
               </content>
            </TitledPane>
            <TitledPane animated="false" collapsible="false" prefWidth="150.0" text="Available Tool Context" HBox.hgrow="NEVER">
               <content>
                  <ListView fx:id="lsvToolCtxAvail">
                     <tooltip>
                        <Tooltip text="Double-click or drag in to use. Alphabetical, since order here does not matter." wrapText="true" />
                     </tooltip></ListView>
               </content>
            </TitledPane>
            <TitledPane animated="false" collapsible="false" prefWidth="150.0" text="Selected Tool Context" HBox.hgrow="NEVER">
               <content>
                  <StackPane>
                     <ListView fx:id="lsvToolCtxSel">
                        <tooltip>
                           <Tooltip text="Double-click or drag out to remove. Drag within or in to set the order the prompt is built in." wrapText="true" />
                     </tooltip>
                        <StackPane.margin>
                           <Insets />
                        </StackPane.margin></ListView>
                     <!-- unmanaged, so the layout never gets a say in its height: showMarker() sets y and width -->
                     <Rectangle fx:id="rectInsertion" arcHeight="0.0" arcWidth="0.0" fill="#0b66c3" height="2.0" managed="false" mouseTransparent="true" stroke="TRANSPARENT" width="150.0" x="0.0" y="0.0" />
                     <padding>
                        <Insets top="0.0" />
                     </padding>
                  </StackPane>
               </content>
            </TitledPane>
            <TitledPane fx:id="tpToolPreview" animated="false" collapsible="false" prefHeight="200.0" text="Tool Preview" HBox.hgrow="ALWAYS">
               <content>
                  <TextArea fx:id="txaToolPreview" editable="false" wrapText="true" />
               </content>
            </TitledPane>
         </children>
      </HBox>
      <HBox>
         <children>
            <Button mnemonicParsing="false" onAction="#onBeginChat" text="Begin Chat">
               <HBox.margin>
                  <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onLoadTools" text="Load Tools">
               <HBox.margin>
                  <Insets bottom="4.0" left="80.0" right="4.0" top="4.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onShowTools" text="Show Tools">
               <HBox.margin>
                  <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onShowFullPrompt" text="Show Full Prompt">
               <HBox.margin>
                  <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
               </HBox.margin>
            </Button>
            <Button mnemonicParsing="false" onAction="#onClearPrompt" text="Clear User Prompt">
               <HBox.margin>
                  <Insets bottom="4.0" left="80.0" right="4.0" top="4.0" />
               </HBox.margin>
            </Button>
         </children>
      </HBox>
      <TitledPane animated="false" collapsible="false" text="Tool Context Summary">
         <content>
            <TextArea fx:id="txaTcSummary" editable="false" prefRowCount="5" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </TextArea>
         </content>
      </TitledPane>
      <TitledPane animated="false" collapsible="false" text="Opening User Prompt" VBox.vgrow="ALWAYS">
         <content>
            <TextArea fx:id="txaUserPrompt" prefRowCount="5" wrapText="true">
               <font>
                  <Font size="14.0" />
               </font>
            </TextArea>
         </content>
      </TitledPane>
   </children>
</VBox>
