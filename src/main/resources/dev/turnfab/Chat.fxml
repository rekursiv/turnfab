<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="dev.turnfab.ChatController">
        <children>
          <StackPane fx:id="stpRenderedConvo" prefHeight="200.0" VBox.vgrow="ALWAYS" />
            <TextArea fx:id="txaToSend" onKeyPressed="#onPromptKey" prefRowCount="1" wrapText="true" VBox.vgrow="NEVER">
                <font>
                    <Font size="18.0" />
                </font>
            </TextArea>
            <HBox VBox.vgrow="NEVER">
                <children>
                    <Button fx:id="btnSend" defaultButton="true" mnemonicParsing="false" onAction="#onSend" text="Send">
                        <HBox.margin>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                        </HBox.margin>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onSaveMd" text="Save MD">
                        <HBox.margin>
                            <Insets bottom="4.0" left="40.0" right="4.0" top="4.0" />
                        </HBox.margin>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onLoadMd" text="Load MD">
                        <HBox.margin>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                        </HBox.margin>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onViewMd" text="View MD">
                        <HBox.margin>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="4.0" />
                        </HBox.margin>
                    </Button>
                    <Button mnemonicParsing="false" onAction="#onCancel" text="Cancel">
                        <HBox.margin>
                            <Insets bottom="4.0" left="40.0" right="4.0" top="4.0" />
                        </HBox.margin>
                    </Button>
                    <Label fx:id="lblCtxUsage" text="Label">
                        <HBox.margin>
                            <Insets bottom="6.0" left="20.0" right="6.0" top="6.0" />
                        </HBox.margin>
                    </Label>
                    <Label fx:id="lblTokPerSec" text="Label">
                        <HBox.margin>
                            <Insets bottom="6.0" left="20.0" right="6.0" top="6.0" />
                        </HBox.margin>
                    </Label>
                </children>
            </HBox>
        </children>
    </VBox>
